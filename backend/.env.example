# Copy this file to ".env" and fill in your actual PostgreSQL credentials.
# On Windows, after installing PostgreSQL, you set a password for the "postgres" user
# during installation — use that below.

# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Leave DATABASE_URL unset to use backend/mediconnect.db (SQLite).
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/mediconnect
APP_ENV=development
AI_SERVICE_URL=http://localhost:8001
# Set the same long random value in the gateway environment before exposing APIs.
SERVICE_TOKEN=
HOSPITAL_TIMEZONE=Asia/Kolkata
BOOKING_OPEN_HOUR=9
BOOKING_CLOSE_HOUR=17
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for production. Demo staff credentials are disabled in production.
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=
